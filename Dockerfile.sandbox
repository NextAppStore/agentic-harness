FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
  git curl python3 python3-pip python3-venv \
  nodejs npm shellcheck wget unzip \
  postgresql postgresql-contrib \
  && rm -rf /var/lib/apt/lists/*

RUN rm -f /usr/lib/python3.*/EXTERNALLY-MANAGED

# Terraform
RUN wget -O- https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg \
  && echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com noble main" > /etc/apt/sources.list.d/hashicorp.list \
  && apt-get update && apt-get install -y terraform packer \
  && rm -rf /var/lib/apt/lists/*

# tflint und tfsec — dieselben Linter wie in den App-Repos (template-app/.github/workflows/terraform.yml).
# Versionen sind gepinnt; arm64 (Apple Silicon) und amd64 werden unterstützt.
ARG TFLINT_VERSION=v0.55.1
ARG TFSEC_VERSION=v1.28.11
RUN arch="$(dpkg --print-architecture)" \
  && wget -qO /tmp/tflint.zip "https://github.com/terraform-linters/tflint/releases/download/${TFLINT_VERSION}/tflint_linux_${arch}.zip" \
  && unzip -q /tmp/tflint.zip -d /usr/local/bin tflint \
  && wget -qO /usr/local/bin/tfsec "https://github.com/aquasecurity/tfsec/releases/download/${TFSEC_VERSION}/tfsec-linux-${arch}" \
  && chmod +x /usr/local/bin/tfsec \
  && rm /tmp/tflint.zip \
  # Der cracklib-Befehl /usr/sbin/packer darf den HashiCorp-Packer nicht verdecken.
  && packer version && tflint --version && tfsec --version && terraform version

# Poetry isoliert
RUN python3 -m venv /opt/poetry \
  && /opt/poetry/bin/pip install --upgrade pip poetry \
  && ln -s /opt/poetry/bin/poetry /usr/local/bin/poetry

# Projekt-Venv
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

RUN pip install --upgrade pip ruff pytest pytest-mock

WORKDIR /tmp/backend
COPY backend/pyproject.toml backend/poetry.lock* /tmp/backend/
RUN poetry config virtualenvs.create false \
  && poetry install --no-root --no-interaction

WORKDIR /workspace
CMD ["/bin/bash"]
